---
import { existsSync } from 'node:fs';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import TechnologyLogo from '../components/TechnologyLogo.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKS, skillGroups, projects } from '../consts';
import avatar from '../images/avatar.webp';
import scotiabankLogo from '../icons/scotiabank.svg';

// Adding public/cv.pdf enables the download on the next build.
const hasCV = existsSync(new URL('../../public/cv.pdf', import.meta.url));
const contributions = [
  {
    title: 'Modernizing banking applications',
    detail: 'Migrated legacy Java applications and upgraded Spring Boot components, contributing to a more maintainable architecture.',
  },
  {
    title: 'Working on business-critical systems',
    detail: 'Contributed to the modernization of a foreign exchange platform used by bank branch executives, with a focus on performance and reliability.',
  },
  {
    title: 'Building confidence through quality',
    detail: 'Addressed vulnerabilities with SonarQube and Fortify, and developed unit and integration tests to support safer changes.',
  },
  {
    title: 'Supporting delivery and production',
    detail: 'Collaborated with QA and DevOps on cloud migrations and deployments using Anthos, with monitoring and troubleshooting through Dynatrace and Argo CD.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress-bar"></div></div>
    <div class="grain" aria-hidden="true"></div>
    <Header />
    <main id="main" class="container" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal-group>
          <p class="eyebrow hero-eyebrow" data-reveal><span class="small-cross" aria-hidden="true">✳</span> Software engineer · Backend & web</p>
          <h1 id="hero-title" data-reveal>Augusto<br />Castillo Vergara<span class="accent">.</span></h1>
          <p class="hero-statement" data-reveal>Thoughtful code.<br /><span>Reliable systems.</span></p>
          <p class="hero-description" data-reveal>I build and modernize software for the banking industry, with a focus on Java, Spring Boot, and maintainable web applications.</p>
          <div class="hero-actions" data-reveal>
            <a class="button button-primary" href="#experience">Explore my experience <Icon name="arrow-down" /></a>
            {hasCV ? (
              <a class="button button-secondary" href="/cv.pdf" download>Download CV <Icon name="download" /></a>
            ) : (
              <a class="button button-secondary" href="#contact">Let's connect <Icon name="message" /></a>
            )}
          </div>
          <div class="hero-socials" data-reveal>
            <a class="text-link" href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /> GitHub <Icon name="arrow-up-right" size={14} /><span class="sr-only"> (opens in a new tab)</span></a>
            <span class="social-divider" aria-hidden="true"></span>
            <a class="text-link" href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /> LinkedIn <Icon name="arrow-up-right" size={14} /><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
        <figure class="portrait" data-reveal style="--reveal-delay: 180ms;">
          <div class="portrait-topline" aria-hidden="true"><span>A little bit of me</span><span>AC / 01</span></div>
          <div class="portrait-stage">
            <span class="portrait-orbit" aria-hidden="true"></span>
            <span class="portrait-initials" aria-hidden="true">AC</span>
            <Image src={avatar} alt="Illustrated avatar of Augusto waving hello" width={320} widths={[320, 640]} sizes="(max-width: 760px) 260px, 320px" loading="eager" class="avatar" />
          </div>
          <figcaption><span class="portrait-mark" aria-hidden="true">&lt;/&gt;</span><span>Curiosity in every line.<br /><strong>Care in every detail.</strong></span></figcaption>
        </figure>
      </section>

      <div class="focus-strip" aria-label="Engineering focus" data-reveal>
        <p class="eyebrow">Built on solid foundations</p>
        <ul><li>Java & Spring Boot</li><li>Clean code</li><li>Hexagonal architecture</li></ul>
      </div>

      <section id="experience" class="section experience-section" aria-labelledby="experience-title">
        <div class="section-heading" data-reveal>
          <div><p class="eyebrow section-label">01 / Experience</p><h2 id="experience-title">Real systems.<br />Real responsibility.</h2></div>
          <p class="section-intro">Building software where reliability,<br class="desktop-break" /> security, and quality matter.</p>
        </div>
        <div class="experience-layout">
          <aside class="experience-meta" aria-label="Role and dates" data-reveal>
            <p class="date"><span class="date-dot" aria-hidden="true"></span><time datetime="2024-02">Feb 2024</time> — Present</p>
            <p class="role">Backend Developer</p>
            <p class="employer">ACGP Ingeniería de Software</p>
            <p class="client-label">Working with</p>
            <div class="client"><Image src={scotiabankLogo} alt="Scotiabank" width={200} loading="lazy" /></div>
            <ul class="tags experience-tags" aria-label="Primary technologies"><li><TechnologyLogo name="Java" size={18} />Java</li><li><TechnologyLogo name="Spring Boot" size={18} />Spring Boot</li><li><Icon name="cloud" size={18} />Cloud</li></ul>
          </aside>
          <div class="contributions" data-reveal-group>
            {contributions.map(({ title, detail }, index) => (
              <article class="contribution" data-reveal>
                <span class="contribution-index" aria-hidden="true">0{index + 1}</span>
                <div><h3>{title}</h3><p>{detail}</p></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="projects" class="section projects-section" aria-labelledby="projects-title">
        <div class="section-heading" data-reveal>
          <div><p class="eyebrow section-label">02 / Projects</p><h2 id="projects-title">Things I've built.</h2></div>
          <p class="section-intro">A selection of work<br class="desktop-break" /> that shows how I think and build.</p>
        </div>
        <div class="projects-grid" data-reveal-group>
          {projects.map(({ title, description, tags, repo, demo, featured }) => (
            <article class:list={['project-card', { 'project-card-featured': featured }]} data-reveal>
              <div class="project-card-top">
                <span class="project-symbol" aria-hidden="true">&lt;/&gt;</span>
                <div class="project-links">
                  {repo && <a class="project-link" href={repo} target="_blank" rel="noopener noreferrer" aria-label={`${title} source code on GitHub`}><Icon name="github" size={16} /><span class="sr-only"> (opens in a new tab)</span></a>}
                  {demo && <a class="project-link" href={demo} target="_blank" rel="noopener noreferrer" aria-label={`${title} live demo`}><Icon name="arrow-up-right" size={16} /><span class="sr-only"> (opens in a new tab)</span></a>}
                </div>
              </div>
              <h3>{title}</h3>
              <p>{description}</p>
              <ul class="tags project-tags" aria-label={`${title} technologies`}>{tags.map((tag) => <li><TechnologyLogo name={tag} />{tag}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>

      <section id="expertise" class="section expertise-section" aria-labelledby="expertise-title">
        <div class="section-heading" data-reveal>
          <div><p class="eyebrow section-label">03 / Expertise</p><h2 id="expertise-title">The tools behind the work.</h2></div>
          <p class="section-intro">A backend foundation.<br class="desktop-break" /> A broader view of the product.</p>
        </div>
        <div class="skills-grid" data-reveal-group>
          {skillGroups.map(({ number, title, description, skills }, index) => (
            <article class:list={['skill-card', { 'skill-card-primary': index === 0 }]} data-reveal>
              <div class="skill-card-top"><span class="skill-symbol" aria-hidden="true">{['{ }', '</>', '↗'][index]}</span><span class="skill-number" aria-hidden="true">{number}</span></div>
              <h3>{title}</h3>
              <p>{description}</p>
              <ul class="tags skill-tags" aria-label={`${title} technologies`}>{skills.map((skill) => <li><TechnologyLogo name={skill} />{skill}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="toolkit" data-reveal>
          <p class="eyebrow">Also in my toolkit</p>
          <ul class="tags" aria-label="Design and development tools">
            {['VS Code', 'Figma', 'JetBrains'].map((tool) => <li><TechnologyLogo name={tool} />{tool}</li>)}
          </ul>
        </div>
      </section>

      <section id="about" class="section about-section" aria-labelledby="about-title">
        <div class="about-heading" data-reveal><p class="eyebrow section-label">04 / Beyond the stack</p><h2 id="about-title">Good software starts<br />with understanding.</h2><span class="about-asterisk" aria-hidden="true">✳</span></div>
        <div class="about-copy" data-reveal>
          <p>I'm Augusto, a software engineer who enjoys making complex systems easier to understand, maintain, and evolve.</p>
          <p>My experience in banking has shaped how I approach development: think about reliability from the start, make decisions with care, and work closely with the people who build and use the software.</p>
          <p>I keep learning across backend and frontend technologies, choosing tools that fit the problem and applying clean code and hexagonal architecture where they help.</p>
          <a class="text-link" href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /> See what I'm working on <Icon name="arrow-up-right" size={16} /><span class="sr-only"> on GitHub (opens in a new tab)</span></a>
        </div>
      </section>

      <section id="contact" class="contact-section" aria-labelledby="contact-title">
        <div class="contact-copy" data-reveal><p class="eyebrow section-label">05 / Let's connect</p><h2 id="contact-title">Have something<br />in mind<span class="accent">?</span></h2><p>A role, a project, or a conversation about software.<br class="desktop-break" /> I'd be happy to hear from you.</p></div>
        <div class="contact-actions" data-reveal><a class="button button-primary" href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer"><span class="button-label"><Icon name="linkedin" />Say hello on LinkedIn</span><Icon name="arrow-up-right" /><span class="sr-only"> (opens in a new tab)</span></a><p>Let's start a conversation.</p></div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .accent { color: var(--accent); }
  .hero { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: center; gap: 64px; padding-block: 76px 64px; }
  .hero-eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 25px; }
  .small-cross { font-size: 22px; line-height: 1; }
  h1 { font-size: clamp(42px, 4.8vw, 66px); letter-spacing: -0.065em; line-height: 1.08; font-weight: 700; }
  .hero-statement { margin-top: 26px; font-size: 26px; font-weight: 500; line-height: 1.35; letter-spacing: -0.035em; }
  .hero-statement span { color: var(--muted); }
  .hero-description { max-width: 460px; margin-top: 20px; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-socials { display: flex; align-items: center; gap: 18px; margin-top: 16px; color: var(--muted); }
  .hero-socials .text-link { font-size: 12px; }
  .social-divider { height: 12px; width: 1px; background: var(--line-strong); }
  .portrait { position: relative; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); overflow: hidden; }
  .portrait-topline { position: relative; z-index: 1; display: flex; justify-content: space-between; padding: 20px 22px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .portrait-stage { position: relative; height: 365px; overflow: hidden; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 40px 40px; background-position: center; }
  .portrait-stage::after { content: ''; position: absolute; inset: 0; background: linear-gradient(var(--surface), transparent 25%, transparent 80%, var(--surface)); pointer-events: none; }
  .portrait-orbit { position: absolute; width: 265px; height: 265px; left: 50%; top: 42%; transform: translate(-50%, -50%); border: 1px solid rgb(var(--accent-rgb) / 30%); border-radius: 50%; background: radial-gradient(circle, rgb(var(--accent-rgb) / 8%), transparent 70%); }
  .portrait-initials { position: absolute; inset: -12px 0 auto; text-align: center; font-size: 180px; letter-spacing: -0.09em; font-weight: 700; line-height: 1; color: rgb(var(--accent-rgb) / 5%); }
  .portrait :global(.avatar) { position: absolute; z-index: 1; bottom: -122px; left: 50%; transform: translateX(-50%); width: 320px; max-width: none; height: auto; }
  figcaption { position: relative; z-index: 2; display: flex; align-items: center; gap: 14px; padding: 20px 24px; border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: 12px; line-height: 1.7; }
  figcaption strong { color: var(--text); font-weight: 500; }
  .portrait-mark { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line-strong); border-radius: 6px; color: var(--accent); font-family: monospace; }
  .focus-strip { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 22px; border-block: 1px solid var(--line); }
  .focus-strip .eyebrow { color: var(--muted); font-size: 10px; }
  .focus-strip ul { display: flex; flex-wrap: wrap; gap: 30px; padding: 0; list-style: none; font-size: 12px; font-weight: 500; }
  .focus-strip li { display: flex; align-items: center; gap: 12px; }
  .focus-strip li::before { content: ''; width: 4px; height: 4px; background: var(--accent); border-radius: 50%; }
  .section { padding-block: 84px; border-bottom: 1px solid var(--line); }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: 40px; }
  .section-label { margin-bottom: 17px; }
  h2 { font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -0.045em; font-weight: 500; }
  .section-intro { color: var(--muted); font-size: 14px; line-height: 1.8; }
  .experience-layout { display: grid; grid-template-columns: 0.8fr 1.7fr; gap: 56px; padding-top: 12px; }
  .experience-meta { padding-top: 2px; }
  .date { display: flex; align-items: center; gap: 7px; color: var(--muted); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 11px; }
  .date-dot { width: 6px; height: 6px; margin-right: 4px; border-radius: 50%; background: var(--accent); }
  .role { margin-top: 20px; font-size: 19px; font-weight: 700; letter-spacing: -0.025em; }
  .employer { margin-top: 4px; color: var(--muted); font-size: 13px; }
  .client-label { margin-top: 27px; color: var(--muted); font-size: 11px; }
  .client { margin-top: 8px; }
  .client :global(img) { width: 200px; height: auto; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
  .tags li { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line-strong); border-radius: 6px; padding: 7px 10px; color: var(--text); font-size: 11px; line-height: 1.6; }
  .skill-tags li { min-height: 40px; background: var(--surface-2); }
  .toolkit { display: flex; align-items: center; flex-wrap: wrap; gap: 18px 28px; padding-top: 26px; }
  .toolkit .eyebrow { color: var(--muted); font-size: 10px; }
  .toolkit .tags li { border-color: var(--line); }
  .experience-tags { margin-top: 22px; }
  .contributions { border-left: 1px solid var(--line); padding-left: 32px; }
  .contribution { display: flex; gap: 20px; padding-block: 24px; border-bottom: 1px solid var(--line); }
  .contribution:first-child { padding-top: 0; }
  .contribution:last-child { padding-bottom: 0; border-bottom: 0; }
  .contribution-index { padding-top: 3px; color: var(--accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 10px; }
  .contribution h3 { margin-bottom: 9px; font-size: 16px; font-weight: 500; letter-spacing: -0.015em; }
  .contribution p { max-width: 65ch; color: var(--muted); font-size: 14px; line-height: 1.8; }
  .skills-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .skill-card { padding: 26px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
  .skill-card-primary { border-top-color: var(--accent); background: linear-gradient(155deg, rgb(var(--accent-rgb) / 4%), transparent 60%), var(--surface); }
  .skill-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 34px; }
  .skill-symbol { color: var(--accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 25px; line-height: 1; }
  .skill-number { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 10px; }
  .skill-card h3 { margin-bottom: 12px; font-size: 18px; letter-spacing: -0.025em; }
  .skill-card > p { min-height: 76px; margin-bottom: 25px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .project-card { display: flex; flex-direction: column; padding: 26px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); transition: border-color 160ms ease, transform 160ms ease; }
  .project-card:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .project-card-featured { border-top-color: var(--accent); background: linear-gradient(155deg, rgb(var(--accent-rgb) / 4%), transparent 60%), var(--surface); }
  .project-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 26px; }
  .project-symbol { color: var(--accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 22px; line-height: 1; }
  .project-links { display: flex; gap: 6px; }
  .project-link { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--line-strong); border-radius: 6px; color: var(--muted); }
  .project-link:hover { border-color: var(--accent); color: var(--accent); }
  .project-card h3 { margin-bottom: 12px; font-size: 18px; letter-spacing: -0.025em; }
  .project-card > p { margin-bottom: 22px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .project-tags { margin-top: auto; }
  .about-section { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
  .about-asterisk { display: block; margin-top: 30px; color: var(--accent); font-size: 78px; line-height: 1; }
  .about-copy { padding-top: 34px; color: var(--muted); font-size: 15px; line-height: 1.9; }
  .about-copy p + p { margin-top: 18px; }
  .about-copy p:first-child { color: var(--text); font-size: 18px; line-height: 1.7; }
  .about-copy .text-link { margin-top: 24px; color: var(--accent); }
  .contact-section { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-block: 84px; }
  .contact-section h2 { font-size: clamp(40px, 5vw, 60px); }
  .contact-copy > p:last-child { margin-top: 22px; color: var(--muted); font-size: 14px; line-height: 1.8; }
  .contact-actions { padding-right: 40px; }
  .contact-actions > p { margin-top: 12px; text-align: center; color: var(--muted); font-size: 11px; }
  /* Cursor-following spotlight on cards. */
  .project-card, .skill-card { position: relative; isolation: isolate; }
  .project-card > *, .skill-card > * { position: relative; z-index: 1; }
  .project-card::before, .skill-card::before { content: ''; position: absolute; inset: 0; z-index: 0; border-radius: inherit; opacity: 0; transition: opacity 260ms ease; pointer-events: none; background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), rgb(var(--accent-rgb) / 12%), transparent 60%); }
  .skill-card::before { background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), rgb(var(--accent-2-rgb) / 12%), transparent 60%); }
  @media (hover: hover) {
    .project-card:hover::before, .skill-card:hover::before { opacity: 1; }
    .skill-tags li, .project-tags li, .toolkit .tags li { transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease; }
    .skill-tags li:hover, .project-tags li:hover, .toolkit .tags li:hover { transform: translateY(-2px); border-color: var(--line-strong); }
  }
  /* Orbiting dot + slow rotation on the portrait ring. */
  .portrait-orbit::after { content: ''; position: absolute; top: -4px; left: 50%; width: 9px; height: 9px; margin-left: -4px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 12px rgb(var(--accent-2-rgb) / 70%); }
  html.motion-ready .portrait-orbit { animation: orbit-spin 18s linear infinite; }
  @keyframes orbit-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
  .portrait :global(.avatar), .portrait-initials { transition: transform 240ms cubic-bezier(0.22, 0.61, 0.36, 1); }

  @media (max-width: 1000px) {
    .hero { gap: 30px; }
    .hero-actions { gap: 10px; }
    .hero-actions .button { padding-inline: 15px; gap: 14px; font-size: 12px; }
    .focus-strip { align-items: flex-start; flex-direction: column; gap: 12px; }
    .experience-layout { gap: 24px; }
    .skill-card { padding: 20px; }
    .skill-card > p { min-height: 96px; }
    .about-section { gap: 40px; }
    .contact-actions { padding-right: 0; }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: 36px; padding-block: 46px 40px; }
    h1 { font-size: clamp(40px, 8vw, 60px); }
    .hero-eyebrow { font-size: 10px; gap: 8px; }
    .hero-description { max-width: 540px; }
    .hero-actions .button { font-size: 13px; }
    .portrait { width: 100%; max-width: 420px; margin-inline: auto; }
    .portrait-stage { height: 265px; }
    .portrait :global(.avatar) { width: 260px; bottom: -115px; }
    .portrait-orbit { width: 210px; height: 210px; }
    .portrait-topline { padding: 15px 20px; }
    figcaption { padding: 14px 20px; }
    .focus-strip ul { gap: 10px 24px; font-size: 11px; }
    .section { padding-block: 56px; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 18px; margin-bottom: 32px; }
    .desktop-break { display: none; }
    .experience-layout { grid-template-columns: 1fr; gap: 30px; }
    .experience-meta { padding-bottom: 28px; border-bottom: 1px solid var(--line); }
    .contributions { padding-left: 18px; }
    .contribution { gap: 14px; }
    .skills-grid { grid-template-columns: 1fr; }
    .projects-grid { grid-template-columns: 1fr; }
    .skill-card { padding: 26px; }
    .skill-card-top { margin-bottom: 24px; }
    .skill-card > p { min-height: 0; max-width: 50ch; }
    .about-section { grid-template-columns: 1fr; gap: 24px; }
    .about-heading { position: relative; padding-right: 32px; }
    .about-asterisk { position: absolute; right: 0; top: 6px; margin-top: 0; font-size: 36px; }
    .about-copy { padding-top: 0; }
    .contact-section { flex-direction: column; align-items: flex-start; gap: 28px; padding-block: 56px; }
    .contact-actions > p { text-align: left; }
  }
  @media (max-width: 360px) {
    h1 { font-size: 36px; }
    .hero-eyebrow { letter-spacing: 0.06em; font-size: 9px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .date { font-size: 10px; }
  }
</style>

<script>
  import Lenis from 'lenis';

  const root = document.documentElement;
  const motionReady = root.classList.contains('motion-ready');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = window.matchMedia('(hover: hover)').matches;

  // Scroll reveal, with a stagger inside each [data-reveal-group].
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  if (motionReady && 'IntersectionObserver' in window) {
    document.querySelectorAll('[data-reveal-group]').forEach((group) => {
      let i = 0;
      Array.from(group.children).forEach((child) => {
        if (child.hasAttribute('data-reveal')) {
          (child as HTMLElement).style.setProperty('--reveal-delay', i * 80 + 'ms');
          i++;
        }
      });
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0, rootMargin: '0px 0px -12% 0px' }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }

  // Scrollspy: highlight the nav link for the section in view.
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-links a[data-section]'));
  const sections = navLinks
    .map((a) => document.getElementById(a.getAttribute('data-section') || ''))
    .filter((el): el is HTMLElement => el !== null);
  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navLinks.forEach((a) => a.classList.toggle('is-active', a.getAttribute('data-section') === id));
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    sections.forEach((s) => spy.observe(s));
  }

  // Cursor-following spotlight on cards.
  if (canHover) {
    document.querySelectorAll<HTMLElement>('.project-card, .skill-card').forEach((card) => {
      card.addEventListener('pointermove', (ev) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', ev.clientX - r.left + 'px');
        card.style.setProperty('--my', ev.clientY - r.top + 'px');
      });
    });
  }

  // Subtle parallax on the portrait.
  if (!reduce && canHover) {
    const stage = document.querySelector<HTMLElement>('.portrait-stage');
    if (stage) {
      const avatar = stage.querySelector<HTMLElement>('.avatar');
      const initials = stage.querySelector<HTMLElement>('.portrait-initials');
      stage.addEventListener('pointermove', (ev) => {
        const r = stage.getBoundingClientRect();
        const x = (ev.clientX - r.left) / r.width - 0.5;
        const y = (ev.clientY - r.top) / r.height - 0.5;
        if (avatar) avatar.style.transform = `translateX(-50%) translate(${x * 10}px, ${y * 8}px)`;
        if (initials) initials.style.transform = `translate(${x * -14}px, ${y * -10}px)`;
      });
      stage.addEventListener('pointerleave', () => {
        if (avatar) avatar.style.transform = 'translateX(-50%)';
        if (initials) initials.style.transform = '';
      });
    }
  }

  // Scroll progress bar + header shadow on scroll.
  const bar = document.querySelector<HTMLElement>('.scroll-progress-bar');
  const header = document.querySelector<HTMLElement>('.site-header');
  let ticking = false;
  function onScroll() {
    const max = root.scrollHeight - root.clientHeight;
    const progress = max > 0 ? root.scrollTop / max : 0;
    if (bar) bar.style.transform = 'scaleX(' + progress + ')';
    if (header) header.classList.toggle('is-scrolled', root.scrollTop > 8);
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true }
  );
  onScroll();

  // Smooth inertia scroll (Lenis) + velocity-driven motion blur. This is what
  // makes navigation feel fluid: the content eases on fling and blurs slightly
  // with speed, then snaps back to sharp as it settles. Skipped entirely under
  // reduced motion, and the blur runs on pointer-capable (desktop) devices only.
  if (!reduce) {
    const lenis = new Lenis({
      duration: 1.05,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    function raf(time: number) {
      lenis.raf(time);
      window.requestAnimationFrame(raf);
    }
    window.requestAnimationFrame(raf);

    // Route in-page anchor links through Lenis (keeps the eased motion + the
    // sticky-header offset), and reflect the section in the URL without jumps.
    const HEADER_OFFSET = -96;
    document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
      const href = link.getAttribute('href') || '';
      const hash = href.includes('#') ? '#' + href.split('#')[1] : '';
      if (hash.length <= 1) return;
      link.addEventListener('click', (ev) => {
        const target = document.querySelector(hash);
        if (!target) return;
        ev.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: HEADER_OFFSET });
        history.replaceState(null, '', hash);
      });
    });

    // Map scroll speed to a small, clamped blur on the main content.
    const mainEl = document.getElementById('main');
    if (mainEl && canHover) {
      lenis.on('scroll', () => {
        const amount = Math.min(Math.abs(lenis.velocity) * 0.22, 4);
        if (amount > 0.35) {
          mainEl.style.willChange = 'filter';
          mainEl.style.filter = `blur(${amount.toFixed(2)}px)`;
        } else if (mainEl.style.filter) {
          mainEl.style.filter = '';
          mainEl.style.willChange = 'auto';
        }
      });
    }
  }
</script>
