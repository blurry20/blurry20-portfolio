---
import Icon from './Icon.astro';

const navigation = [
  { href: '/#experience', label: 'Experience', section: 'experience' },
  { href: '/#projects', label: 'Projects', section: 'projects' },
  { href: '/#expertise', label: 'Expertise', section: 'expertise' },
  { href: '/#about', label: 'About', section: 'about' },
];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <nav class="container navigation" aria-label="Main navigation">
    <a class="wordmark" href="/" aria-label="Augusto Castillo — home">
      <img src="/gateto.svg" width="28" height="28" alt="" />
      <span>augusto<span class="wordmark-dot">.</span></span>
    </a>
    <div class="nav-right">
      <ul class="nav-links">
        {navigation.map(({ href, label, section }) => <li><a href={href} data-section={section}>{label}</a></li>)}
        <li><a class="nav-contact" href="/#contact"><Icon name="message" size={16} /> Let's talk</a></li>
      </ul>
      <button class="theme-toggle" type="button" aria-label="Switch theme">
        <span class="icon-sun"><Icon name="sun" size={18} /></span>
        <span class="icon-moon"><Icon name="moon" size={18} /></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--line); background: var(--header-background); backdrop-filter: blur(16px); transition: border-color 200ms ease, box-shadow 200ms ease; }
  .site-header.is-scrolled { border-bottom-color: var(--line-strong); box-shadow: 0 16px 40px -28px rgb(0 0 0 / 55%); }
  .navigation { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 700; letter-spacing: -1px; text-decoration: none; }
  .wordmark-dot { color: var(--accent-strong); }
  .nav-right { display: flex; align-items: center; gap: 22px; }
  .nav-links { display: flex; align-items: center; gap: 30px; list-style: none; padding: 0; margin: 0; }
  .nav-links a { position: relative; font-size: 13px; font-weight: 500; text-decoration: none; color: var(--muted); }
  .nav-links a:hover { color: var(--text); }
  .nav-links a[data-section].is-active { color: var(--text); }
  .nav-links a[data-section].is-active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -7px; height: 2px; border-radius: 2px; background: var(--accent-2); }
  .nav-links .nav-contact { display: inline-flex; align-items: center; gap: 14px; color: var(--text); padding: 9px 15px; border: 1px solid var(--line-strong); border-radius: 6px; }
  .nav-links .nav-contact:hover { border-color: var(--accent); color: var(--accent-strong); }
  .theme-toggle { display: inline-grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 1px solid var(--line-strong); border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease; }
  .theme-toggle:hover { color: var(--accent-strong); border-color: var(--accent); }
  .theme-toggle span { display: inline-flex; }
  .theme-toggle .icon-moon { display: none; }
  :root[data-theme='light'] .theme-toggle .icon-sun { display: none; }
  :root[data-theme='light'] .theme-toggle .icon-moon { display: inline-flex; }
  @media (max-width: 600px) {
    .navigation { min-height: 72px; gap: 12px; flex-wrap: wrap; padding-block: 14px; }
    .wordmark { font-size: 20px; }
    .wordmark img { width: 24px; height: 24px; }
    .nav-right { width: 100%; justify-content: space-between; gap: 10px; }
    .nav-links { gap: 8px; }
    .nav-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; }
    .nav-links a[data-section].is-active::after { bottom: 4px; }
    .nav-links .nav-contact { padding: 6px 10px; gap: 8px; }
    .theme-toggle { width: 38px; height: 38px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;

  // Reflect the current theme on the button + browser UI (no persistence —
  // that way an untouched toggle keeps following the system preference).
  function reflect(theme: string) {
    if (btn) btn.setAttribute('aria-label', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'light' ? '#f6f4ef' : '#131210');
  }

  if (btn) {
    reflect(root.dataset.theme || 'dark');
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      reflect(next);
    });
  }
</script>
