---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import java from '../icons/java.svg';
import spring from '../icons/springboot.svg';
import junit from '../icons/junit.svg';
import mockito from '../icons/mockito.png';
import python from '../icons/python.png';
import typescript from '../icons/typescript.svg';
import javascript from '../icons/javascript.svg';
import react from '../icons/react.svg';
import next from '../icons/nextjs.svg';
import astro from '../icons/astro.svg';
import tailwind from '../icons/tailwindcss.svg';
import node from '../icons/nodejs.svg';
import docker from '../icons/docker.webp';
import git from '../icons/git.svg';
import jenkins from '../icons/jenkins.svg';
import dynatrace from '../icons/dynatrace.webp';
import vscode from '../icons/vscode.svg';
import figma from '../icons/figma.svg';
import jetbrains from '../icons/jetbrains.png';
import css from '../icons/css.svg';
import html from '../icons/html5.svg';

interface Props { name: string; size?: number; }
const { name, size = 22 } = Astro.props;
const logos: Record<string, ImageMetadata> = {
  Java: java, 'Spring Boot': spring, JUnit: junit, Mockito: mockito, Python: python,
  TypeScript: typescript, JavaScript: javascript, React: react, 'Next.js': next,
  Astro: astro, 'Tailwind CSS': tailwind, 'Node.js': node, Docker: docker, Git: git,
  Jenkins: jenkins, Dynatrace: dynatrace, 'VS Code': vscode, Figma: figma, JetBrains: jetbrains,
  CSS: css, HTML: html,
};
const logo = logos[name];
---

{logo && <Image class="technology-logo" src={logo} alt="" width={size * 2} loading="lazy" style={{ width: `${size}px`, height: `${size}px` }} />}

<style>
  .technology-logo { display: block; flex: 0 0 auto; object-fit: contain; }
</style>
